pipeline {
    agent any

    environment {
        ARM_TENANT_ID       = credentials('AZURE_TENANT_ID')
        ARM_CLIENT_ID       = credentials('AZURE_TERRAFORM_APP_ID')
        ARM_CLIENT_SECRET   = credentials('AZURE_APP_SECRET')
        ARM_SUBSCRIPTION_ID = credentials('AZURE_SUBSCRIPTION_ID')
        TF_CLI_ARGS         = "-no-color"
    }

    stages {
        stage('Check Dependencies') {
            parallel {
                stage('Terraform') {
                    steps {
                        sh '''
                            if terraform version > /dev/null; then
                                echo "Terraform installed with version: $(terraform version)"
                            else
                                echo "Terraform not installed!!!"
                                exit 1
                            fi
                        '''
                    }
                }

                stage('Azure CLI') {
                    steps {
                        sh '''
                            if az version > /dev/null; then
                                echo "Azure CLI installed - $(az version)"
                            else
                                echo "Azure CLI not installed!!!"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }

        stage('Azure CLI Login') {
            steps {
                echo "Logging into Azure CLI"

                dir('terraform') {
                    sh '''
                        az login --service-principal --username $ARM_CLIENT_ID --password $ARM_CLIENT_SECRET --tenant $ARM_TENANT_ID
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                echo "Initializing Terraform"

                dir('terraform') {
                    sh '''
                        terraform init
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                echo "Validating Terraform"

                dir('terraform') {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                echo "Planning Terraform"

                dir('terraform') {
                    sh '''
                        terraform plan -var-file=dev.tfvars
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { params.Deploy_Terraform }
            }
            steps {
                echo "Applying Terraform in Azure"

                dir('terraform') {
                    sh '''
                        terraform apply -var-file=dev.tfvars -auto-approve
                    '''
                }
            }
        }
    }
}