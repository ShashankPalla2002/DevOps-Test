pipeline {
    agent any

    environment {
        azure_tenant_id  = credentials('AZURE_TENANT_ID')
        azure_app_id     = credentials('AZURE_TERRAFORM_APP_ID')
        azure_app_secret = credentials('AZURE_APP_SECRET')
        TF_CLI_ARGS      = "-no-color"
    }

    stages {
        stage('Check Dependencies') {
            parallel {
                stage('Terraform') {
                    steps {
                        sh '''
                            if terraform version > /dev/null; then
                                echo "Terraform installed with version: $(terraform version)"
                            else
                                echo "Terraform not installed!!!"
                                exit 1
                            fi
                        '''
                    }
                }

                stage('Azure CLI') {
                    steps {
                        sh '''
                            if az version > /dev/null; then
                                echo "Azure CLI installed - $(az version)"
                            else
                                echo "Azure CLI not installed!!!"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }

        stage('Azure CLI Login') {
            steps {
                echo "Logging into Azure CLI"

                dir('terraform') {
                    sh '''
                        az login --service-principal --username $azure_app_id --password $azure_app_secret --tenant $azure_tenant_id
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                echo "Initializing Terraform"

                dir('terraform') {
                    sh '''
                        terraform init
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                echo "Validating Terraform"

                dir('terraform') {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                echo "Planning Terraform"

                dir('terraform') {
                    sh '''
                        terraform plan -var-file=dev.tfvars
                    '''
                }
            }
        }
    }
}